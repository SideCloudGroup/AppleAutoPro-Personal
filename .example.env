# ============ Docker Compose 配置 ============
# 项目名称，同一服务器部署多个实例时需修改
COMPOSE_PROJECT_NAME=appleautopro

# ============ 数据库配置 ============
# MariaDB 连接信息
# 注意：Docker部署时HOST无需修改，生成数据后请勿改动密码
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_ROOT_PASSWORD=123456
MARIADB_DATABASE=appleautopro
MARIADB_USER=appleautopro
MARIADB_PASSWORD=123456

# ============ Redis 配置 ============
# 默认情况无需设置密码
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SELECT=0
REDIS_PREFIX=appleauto_

# ============ 应用服务配置 ============
# Web服务端口
WEB_PORT=18523
# 后端线程数，控制任务并发数
BACKEND_THREADS=1
# 网站访问域名，需与授权域名一致（http://或https://开头，结尾无斜杠）
API_URL=

# ============ 安全配置 ============
# API密钥，请修改为随机字符串
API_KEY=
# 授权码，若使用离线证书请留空
LICENSE=

# ============ 语言和时区 ============
# 默认语言：zh_cn/en_us/vi_vn
APP_LANG=zh_cn
# 时区设置
TIMEZONE=Asia/Shanghai

# ============ 集群配置 ============
# 后端节点标识符，用于区分不同节点
NODENAME=default

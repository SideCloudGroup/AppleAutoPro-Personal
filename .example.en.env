# ============ Docker Compose Configuration ============
# Project name, modify this when deploying multiple instances on the same server
COMPOSE_PROJECT_NAME=appleautopro

# ============ Database Configuration ============
# MariaDB connection settings
# Note: No need to modify HOST for Docker deployment, do not change passwords after data is generated
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_ROOT_PASSWORD=123456
MARIADB_DATABASE=appleautopro
MARIADB_USER=appleautopro
MARIADB_PASSWORD=123456

# ============ Redis Configuration ============
# No password required by default
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SELECT=0
REDIS_PREFIX=appleauto_

# ============ Application Service Configuration ============
# Web service port
WEB_PORT=18523
# Backend threads, controls task concurrency
BACKEND_THREADS=4
# Website domain, must match the licensed domain (starts with http:// or https://, no trailing slash)
API_URL=

# ============ Security Configuration ============
# API key, change to a random string
API_KEY=
# License code, leave empty if using offline certificate
LICENSE=

# ============ Language and Timezone ============
# Default language: zh_cn/en_us/vi_vn
APP_LANG=zh_cn
# Timezone setting
TIMEZONE=Asia/Shanghai

# ============ Cluster Configuration ============
# Backend node identifier, used to distinguish different nodes
NODENAME=default
